{
    "logging": {
        "level": "INFO",
        "file_level": "DEBUG",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    },
    "paths": {
        "data_dir": "data",
        "model_dir": "models",
        "log_dir": "logs"
    },
    "emg_sessantaquatro": {
        "port": "COM3",
        "baudrate": 115200,
        "sampling_rate": 2048,
        "channels": 64,
        "resolution": 24,
        "reference": "monopolar"
    },
    "emg_trigno": {
        "host": "127.0.0.1",
        "command_port": 50040,
        "emg_port": 50041,
        "aux_port": 50042,
        "sampling_rate": 2000,
        "channels": 16,
        "resolution": 16,
        "use_aux_data": false
    },
    "emg_processing": {
        "window_size": 1024,
        "window_overlap": 512,
        "bandpass_low": 10.0,
        "bandpass_high": 500.0,
        "notch_freq": 50.0,
        "notch_quality": 30.0,
        "highpass_cutoff": 20.0,
        "lowpass_cutoff": 450.0,
        "buffer_time": 5.0,
        "feature_window": 0.25,
        "feature_overlap": 0.5,
        "features_enabled": [
            "rms",
            "mav",
            "zc",
            "ssc",
            "wl",
            "var",
            "freq_mean",
            "freq_median",
            "freq_power"
        ],
        "decomposition_method": "FastICA"
    },
    "recording": {
        "save_raw_emg": true,
        "save_processed_emg": true,
        "save_decomposed_mus": true
    },
    "decoding": {
        "classifiers": [
            "kNN",
            "MLP"
        ],
        "features": [
            "RMS",
            "MAV",
            "WL",
            "ZC",
            "SSC",
            "AR"
        ],
        "training_ratio": 0.7,
        "cv_folds": 5,
        "normalize": true
    },
    "unity_interface": {
        "ip_address": "127.0.0.1",
        "port": 9000,
        "protocol": "UDP",
        "update_rate": 30,
        "command_delay": 0.01
    },
    "dof_config": {
        "thumb": [
            "flexion",
            "extension",
            "pinching"
        ],
        "index": [
            "flexion",
            "extension",
            "pinching"
        ],
        "middle": [
            "flexion",
            "extension",
            "pinching"
        ],
        "ring_little": [
            "flexion",
            "extension"
        ],
        "thumb_abduction": true
    }
}